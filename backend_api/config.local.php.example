<?php

declare(strict_types=1);

// Copiar a config.local.php en ~/hobbystore/<env>/ (flamenco). No va a git.
// En flamenco SELinux (Enforcing) impide a PHP-FPM usar el socket Unix de
// Postgres; por eso se conecta por TCP a 127.0.0.1 con el password del rol
// marco. Este archivo queda con chmod 600.
return [
    'env' => 'staging', // staging | prod
    'db' => [
        'dsn' => 'pgsql:host=127.0.0.1;dbname=gyros',
        'user' => 'marco',
        'password' => 'PASSWORD_DEL_ROL_MARCO',
        'schema' => 'hobbystore_staging', // hobbystore en prod
    ],
    'otp_session_url' => 'https://www.quanticasoft.com/otp/session.php',
    'media_base_url' => 'https://www.quanticasoft.com/hobbystore/media-staging', // .../media en prod
    'media_dir' => '/webs/quanticasoft/hobbystore/media-staging', // .../media en prod
];
